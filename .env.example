# Aimighty OpenVINO Embedder - Environment Configuration

# User/Timezone
PUID=1000
PGID=1000
TZ=Etc/UTC

# Server
MODEL_NAME=aimighty-embedding-4b
HF_MODEL_ID=Qwen/Qwen3-Embedding-4B
PORT=9997

# HuggingFace (optional, for gated models)
HUGGING_FACE_HUB_TOKEN=

# Model Cache
MODEL_CACHE_DIR=/models_cache
OV_CACHE_DIR=/tmp/ov_cache

# OpenVINO CPU Configuration
# OV_DEVICE: CPU for CPU-only, GPU for iGPU acceleration (Level Zero)
OV_DEVICE=CPU
# PERFORMANCE_HINT: THROUGHPUT for batch processing, LATENCY for single requests
PERFORMANCE_HINT=THROUGHPUT
# NUM_STREAMS: parallel execution streams (1 recommended when batching is active)
NUM_STREAMS=1
# INFERENCE_THREADS: OpenVINO CPU inference threads (P-cores on Core Ultra)
INFERENCE_THREADS=8
# CPU_PINNING: YES for deterministic core scheduling (nice 10 already yields priority)
CPU_PINNING=YES

# Server behavior
# MAX_LENGTH: max tokens per input text (model supports up to 32768)
MAX_LENGTH=8192
# EMBED_DIM: output embedding dimension; 0 = full (2560), 32..2560 = Matryoshka (MRL) slice
EMBED_DIM=0
# DEFAULT_INSTRUCTION: optional query-side task instruction, e.g.
#   "Given a web search query, retrieve relevant passages that answer the query"
# (per-request "instruction" field in /v1/embeddings overrides this)
DEFAULT_INSTRUCTION=
# BATCH_WINDOW_MS: coalescing window for concurrent requests (batched inference)
BATCH_WINDOW_MS=5
# INFER_TIMEOUT_SEC: per-request inference timeout
INFER_TIMEOUT_SEC=300

# OpenVINO GPU Configuration
# INFERENCE_PRECISION_HINT: f16 for iGPU, f32 for CPU
INFERENCE_PRECISION_HINT=f16
# GPU_ENABLE_LARGE_ALLOCATIONS: YES to remove 4.2GB unified memory limit
GPU_ENABLE_LARGE_ALLOCATIONS=YES

# Memory Optimization
MALLOC_ARENA_MAX=1